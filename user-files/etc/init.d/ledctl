#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

# 硬件守卫：后端只认 /sys/class/leds/{red,green,blue}:status 三色 PWM LED。
# 没这套节点的机型不启动守护（灯效循环是死循环，空转会白占 CPU）。
led_hw_present() {
	[ -d /sys/class/leds/red:status ] && [ -d /sys/class/leds/green:status ] && [ -d /sys/class/leds/blue:status ] && return 0
	for l in /sys/class/leds/*:status; do
		[ -d "$l" ] || continue
		case "$l" in *red*) return 0 ;; esac
	done
	return 1
}

start_service() {
	led_hw_present || {
		logger -t ledctl "RGB status LED not found, daemon skipped (unsupported hardware)" 2>/dev/null || :
		return 0
	}

	config_load led
	config_get mode led mode static
	config_get en   led enabled 1

	# 先按保存的配置落一次硬件（static 立即生效，灯效交给守护）
	[ -n "$LED_SKIP_APPLY" ] || LED_NO_DAEMON=1 /usr/sbin/ledctl apply >/dev/null 2>&1

	procd_open_instance
	procd_set_param command /usr/sbin/ledctl daemon
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	:
}
