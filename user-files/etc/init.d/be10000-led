#!/bin/sh /etc/rc.common
# Xiaomi BE10000 RGB 氛围灯守护 (:ambient)
START=97
STOP=01
USE_PROCD=1

board_ok() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		xiaomi,be10000|xiaomi,be10000-es) return 0 ;;
	esac
	return 1
}
hw_ok() { [ -e /sys/class/leds/red:ambient/brightness ] && [ -e /sys/class/leds/green:ambient/brightness ] && [ -e /sys/class/leds/blue:ambient/brightness ]; }

start_service() {
	board_ok || { logger -t be10000-led 'not BE10000, skip'; return 0; }
	hw_ok    || { logger -t be10000-led 'no :ambient LEDs, skip'; return 0; }
	procd_open_instance
	procd_set_param command /usr/sbin/be10000-ledctl daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	board_ok || return 0
	local l
	for l in red green blue; do
		[ -e "/sys/class/leds/$l:ambient/brightness" ] && echo 0 > "/sys/class/leds/$l:ambient/brightness"
	done
	rm -f /var/run/be10000-led.json
}
