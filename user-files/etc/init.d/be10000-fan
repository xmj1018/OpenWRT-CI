#!/bin/sh /etc/rc.common
# Xiaomi BE10000 智能风扇守护 (EMC2305)
START=96
STOP=01
USE_PROCD=1

board_ok() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		xiaomi,be10000|xiaomi,be10000-es) return 0 ;;
	esac
	return 1
}
hw_ok() {
	local d
	for d in /sys/bus/i2c/devices/*-002f/hwmon/hwmon*; do
		[ "$(cat "$d/name" 2>/dev/null)" = "emc2305" ] && [ -e "$d/pwm1" ] && return 0
	done
	return 1
}

start_service() {
	board_ok || { logger -t be10000-fan 'not BE10000, skip'; return 0; }
	hw_ok    || { logger -t be10000-fan 'no emc2305, skip'; return 0; }
	procd_open_instance
	procd_set_param command /usr/sbin/be10000-fanctl daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	board_ok || return 0
	local d
	for d in /sys/bus/i2c/devices/*-002f/hwmon/hwmon*/pwm1; do
		[ -e "$d" ] && echo 255 > "$d"
	done
	rm -f /var/run/be10000-fan.json
}
